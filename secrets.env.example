# JIRA CIPOE Analytics - Secrets Configuration
# Copy this file to secrets.env and replace the YOUR_*_HERE values with real credentials
# IMPORTANT: Quote values that contain special characters like colons, forward slashes, etc.

# JIRA Configuration
JIRA_BASE_URL="https://issues.redhat.com"
JIRA_TOKEN="YOUR_JIRA_PERSONAL_ACCESS_TOKEN_HERE"

# Neo4j Configuration  
NEO4J_PASSWORD="YOUR_SECURE_NEO4J_PASSWORD_HERE"
